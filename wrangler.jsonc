{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "round-fuda",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "round-fuda.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["41 18 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "round-fuda",
      "database_id": "b1cdff0e-95db-4219-a6ae-83eff009b082",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
